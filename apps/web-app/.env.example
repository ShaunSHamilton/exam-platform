# Release image to run instead of building:
# registry.digitalocean.com/<registry>/web-app@sha256:<digest>
# Empty: `docker compose up --build` builds from source. Komodo sets it on every deploy.
IMAGE=
# aAPI origin the browser calls. Validated as a URL by astro.config.ts. Baked into the build,
# including the image (`docker compose up --build` passes it as a build arg).
PUBLIC_AUTH_API_URL=http://127.0.0.1:13001
# Host port on 127.0.0.1 for the container. The container always listens on 13004.
WAPP_PORT=13004
PLATFORM_NETWORK=platform
