# Host port on 127.0.0.1. The container always listens on 13003.
EDD_PORT=13003
# development: logs to stdout, Sentry optional. staging/production: Sentry required, stdio
# carries errors only.
ENVIRONMENT=development
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.2
# Filters what reaches stdout (development) and Sentry (all environments).
RUST_LOG=info
PLATFORM_NETWORK=platform
