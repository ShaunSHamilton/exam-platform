{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "packages": {
    ".": {
      "component": "curriculum-api",
      "changelog-path": "apps/curriculum-api/CHANGELOG.md",
      "exclude-paths": [
        ".github",
        ".vscode",
        "apps/auth-api",
        "apps/desktop-app",
        "apps/examiner-dashboard",
        "apps/web-app",
        "databases",
        "deploy",
        "docs",
        "release-please"
      ],
      "extra-files": [
        {
          "type": "toml",
          "path": "apps/curriculum-api/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='curriculum-api')].version"
        }
      ]
    }
  }
}
