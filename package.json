{
  "name": "exam-platform",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/web-app",
      "apps/examiner-dashboard/client",
      "apps/desktop-app"
    ],
    "catalog": {
      "@tanstack/react-query": "5.104.1",
      "@tanstack/react-query-devtools": "5.104.1",
      "@types/bun": "1.4.2",
      "@types/react": "19.3.0",
      "@types/react-dom": "19.3.0",
      "react": "19.3.0",
      "react-dom": "19.3.0"
    },
    "catalogs": {
      "astro": {
        "@astrojs/check": "0.9.10",
        "@astrojs/react": "7.0.0",
        "astro": "7.3.5",
        "typescript": "6.0.3"
      }
    }
  },
  "scripts": {
    "dev": "bun --filter web-app --filter examiner-dashboard-client dev",
    "dev:desktop": "bun --filter desktop-app tauri:dev",
    "build": "bun --filter '*' build",
    "check": "bun --filter '*' check"
  }
}
