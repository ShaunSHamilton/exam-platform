{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/v17.6.0/schemas/config.json",
  "release-type": "simple",
  "separate-pull-requests": true,
  "include-component-in-tag": true,
  "bump-minor-pre-major": true,
  "initial-version": "0.1.0",
  "packages": {
    "apps/auth-api": {
      "component": "auth-api",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='auth-api')].version"
        }
      ]
    },
    "apps/curriculum-api": {
      "component": "curriculum-api",
      "extra-files": [
        {
          "type": "toml",
          "path": "Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='curriculum-api')].version"
        }
      ]
    },
    "apps/examiner-dashboard": {
      "component": "examiner-dashboard",
      "extra-files": [
        {
          "type": "toml",
          "path": "server/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "/Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='examiner-dashboard')].version"
        },
        {
          "type": "json",
          "path": "client/package.json",
          "jsonpath": "$.version"
        }
      ]
    },
    "apps/web-app": {
      "component": "web-app",
      "extra-files": [
        { "type": "json", "path": "package.json", "jsonpath": "$.version" }
      ]
    },
    "apps/desktop-app": {
      "component": "desktop-app",
      "extra-files": [
        { "type": "json", "path": "package.json", "jsonpath": "$.version" },
        {
          "type": "toml",
          "path": "backend/Cargo.toml",
          "jsonpath": "$.package.version"
        },
        {
          "type": "toml",
          "path": "Cargo.lock",
          "jsonpath": "$.package[?(@.name.value==='desktop-app')].version"
        }
      ]
    }
  }
}
