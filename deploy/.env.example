# bootstrap.sh copies this to .env next to compose.yaml and fills each empty secret once with
# `openssl rand -hex 32`. .env stays on the Droplet (chmod 600); never commit it.

# Public names: DNS records for both point at the Droplet. GitHub's KOMODO_URL is
# https://<KOMODO_DOMAIN>.
KOMODO_DOMAIN=exam-platform.freecodecamp.dev
EXAMINER_DASHBOARD_DOMAIN=examiner-dashboard.freecodecamp.dev
# Komodo's first admin, created on the first start only. Change the password after logging in.
KOMODO_INIT_ADMIN_USERNAME=admin
KOMODO_INIT_ADMIN_PASSWORD=
# MongoDB root user, created on the first start only.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=
# Signs login sessions: rotating it logs everyone out.
KOMODO_JWT_SECRET=
# Authenticates incoming webhooks. None are configured, but Core requires one.
KOMODO_WEBHOOK_SECRET=
# Google login for Komodo: a Google Cloud OAuth client (web application). Set by hand.
KOMODO_GOOGLE_OAUTH_ENABLED=false
KOMODO_GOOGLE_OAUTH_ID=
KOMODO_GOOGLE_OAUTH_SECRET=
