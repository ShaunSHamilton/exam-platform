# Copy to .env next to compose.yaml on the VM. It stays there: chmod 600, never commit.
# Generate each secret with `openssl rand -hex 32`.

# Public name for Komodo: a DNS record pointing at the VM. GitHub's KOMODO_URL is https://<this>.
KOMODO_DOMAIN=komodo.example.org
# MongoDB root user, created on the first start only.
KOMODO_DATABASE_USERNAME=komodo
KOMODO_DATABASE_PASSWORD=
# Signs login sessions: rotating it logs everyone out.
KOMODO_JWT_SECRET=
# Authenticates incoming webhooks. None are configured, but Core requires one.
KOMODO_WEBHOOK_SECRET=
